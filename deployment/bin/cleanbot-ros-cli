#!/usr/bin/env bash
# 文件作用：加载 Cleanbot ROS2 环境，并以隔离的运行目录执行 ros2 命令行工具。
set -euo pipefail

source /opt/ros/humble/setup.bash
source /opt/cleanbot/current/install/setup.bash

export ROS_HOME=/var/lib/cleanbot/runtime/updater-ros-home
export ROS_LOG_DIR=/var/lib/cleanbot/runtime/updater-ros-log
export ROS2CLI_NO_DAEMON=1
exec ros2 "$@"
