<?xml version="1.0"?>
<!-- 文件作用：声明清扫建模 ROS 2 包的名称、依赖和导出信息。 -->
<package format="3">
  <name>cleanbot_modeling</name>
  <version>0.1.0</version>
  <description>RTK point modeling, coverage planning, and persistent cleaning plans.</description>
  <maintainer email="engineering@cleanbot.local">Cleanbot Engineering</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cleanbot_common</depend>
  <depend>cleanbot_config</depend>
  <depend>cleanbot_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sqlite3_vendor</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
