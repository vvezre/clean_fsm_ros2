<?xml version="1.0"?>
<!-- 文件作用：声明云端网关 ROS 2 包的名称、依赖和导出信息。 -->
<package format="3">
  <name>cleanbot_gateway</name>
  <version>0.1.0</version>
  <description>Cloud MQTT to ROS2 control gateway for cleanbot.</description>
  <maintainer email="engineering@cleanbot.local">Cleanbot Engineering</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>cleanbot_common</depend>
  <depend>cleanbot_config</depend>
  <depend>cleanbot_control</depend>
  <depend>cleanbot_interfaces</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>libpaho-mqttpp-dev</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
