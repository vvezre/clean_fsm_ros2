<?xml version="1.0"?>
<package format="3">
  <name>cleanbot_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration package for the cleanbot runtime.</description>
  <maintainer email="engineering@cleanbot.local">Cleanbot Engineering</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cleanbot_config</exec_depend>
  <exec_depend>cleanbot_hardware</exec_depend>
  <exec_depend>cleanbot_rtk</exec_depend>
  <exec_depend>cleanbot_control</exec_depend>
  <exec_depend>cleanbot_mission</exec_depend>
  <exec_depend>cleanbot_modeling</exec_depend>
  <exec_depend>cleanbot_http</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
